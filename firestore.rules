rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Nur angemeldete Nutzer dürfen lesen oder schreiben. Accounts werden
    // manuell in der Firebase Console angelegt, es gibt keine Registrierung.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
