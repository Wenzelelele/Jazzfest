rules_version = '2';

// Rollen:
// - Jeder angemeldete Account (manuell in der Firebase Console angelegt, es
//   gibt keine Registrierung) darf Events lesen, Gäste anlegen, bearbeiten,
//   löschen, einchecken und die Abendkasse zählen.
// - Admins (Dokument admins/{uid} existiert) dürfen zusätzlich Events
//   verwalten und Mitglieder (quelle "mitglied") importieren/übernehmen.
//
// Den ersten Admin legt man in der Firebase Console an: Collection
// "admins", Dokument-ID = UID des Accounts (die App zeigt die eigene UID auf
// der Event-Seite an). Weitere Rollen vergibt ein Admin in der App. Bewusst
// keine E-Mail-Adresse hier im Code - das Repository ist öffentlich.
// Die Rollen Kasse/Anfrage (einchecken vs. Gäste anfragen) unterscheidet
// nur die Oberfläche.
service cloud.firestore {
  match /databases/{database}/documents {
    function angemeldet() {
      return request.auth != null;
    }

    function istAdmin() {
      return angemeldet() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Jeder darf prüfen, ob er selbst Admin ist; Admins sehen alle und
    // vergeben die Rolle über die Benutzer-Seite der App. Den allerersten
    // Admin legt man in der Console an.
    match /admins/{uid} {
      allow read: if angemeldet() && (request.auth.uid == uid || istAdmin());
      allow write: if istAdmin();
    }

    // Selbstregistrierung (E-Mail, zuletzt aktiv) für die Benutzer-Seite.
    // Die Rolle (Kasse/Anfrage) setzt nur ein Admin - die Abgrenzung
    // Kasse/Anfrage ist bewusst nur in der Oberfläche, nicht hier.
    match /nutzer/{uid} {
      allow read: if angemeldet();
      allow create: if angemeldet() && request.auth.uid == uid &&
        !('rolle' in request.resource.data);
      allow update: if istAdmin() || (
        angemeldet() && request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['rolle'])
      );
      allow delete: if istAdmin();
    }

    match /events/{eventId} {
      allow read: if angemeldet();
      allow create, delete: if istAdmin();
      // Nicht-Admins dürfen am Event-Dokument nur den Abendkassen-Zähler
      // ändern.
      allow update: if istAdmin() || (
        angemeldet() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['abendkasse'])
      );

      match /gaeste/{gastId} {
        allow read: if angemeldet();
        // Mitglieder-Einträge anlegen (Import/Übernahme) nur als Admin.
        allow create: if istAdmin() || (
          angemeldet() && request.resource.data.quelle != 'mitglied'
        );
        // Bearbeiten/Einchecken: alle, aber niemand ohne Admin-Rechte darf
        // einen Gast zum Mitglied machen (oder umgekehrt).
        allow update: if istAdmin() || (
          angemeldet() && request.resource.data.quelle == resource.data.quelle
        );
        allow delete: if angemeldet();
      }
    }

    // Alte, event-lose Collection aus der Zeit vor Events: nur noch lesen
    // und (für die Migration) vom Admin verschieben/löschen.
    match /gaeste/{gastId} {
      allow read: if angemeldet();
      allow write: if istAdmin();
    }
  }
}
